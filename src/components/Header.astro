---
const { pathname = '/' } = Astro.props;
const links = [
  { href: '/', label: '首页' },
  { href: '/projects/', label: '项目' },
  { href: '/notes/', label: '随笔' },
  { href: '/about/', label: '关于' }
];
---

<a class="skip-link" href="#main">跳到正文</a>
<header class="site-header">
  <nav class="nav container" aria-label="主导航" data-js="false">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">徐</span>
      <span>徐苏洋</span>
      <span class="brand-tag">ENGINEERING</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">菜单</button>
    <div class="nav-links" id="nav-links" data-open="false">
      {links.map((link) => (
        <a href={link.href} aria-current={pathname === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
      <a class="nav-cta" href="mailto:2307456010@qq.com">联系 ↗</a>
    </div>
  </nav>
</header>
<script>
  // Progressive enhancement: only collapse the nav once JS can reopen it.
  const nav = document.querySelector<HTMLElement>('.nav');
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const links = document.querySelector<HTMLElement>('#nav-links');

  if (nav && button && links) {
    nav.dataset.js = 'true';

    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      links.dataset.open = String(open);
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    // Collapse on Escape, and move focus back to the trigger.
    links.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Escape') {
        setOpen(false);
        button.focus();
      }
    });

    // Collapse after navigating to a same-page anchor on small screens.
    links.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).tagName === 'A') setOpen(false);
    });
  }
</script>
