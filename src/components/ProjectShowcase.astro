---
import type { ProjectEvidence } from '../data/evidence';

interface Props {
  evidence: ProjectEvidence;
  projectTitle: string;
}

const { evidence, projectTitle } = Astro.props;
const hasVideo = (item: { videoMp4?: string; videoWebm?: string }) => Boolean(item.videoMp4 || item.videoWebm);
---

<section class="showcase container" aria-labelledby="showcase-title">
  <header class="showcase-header">
    <h2 id="showcase-title">界面与演示</h2>
    <span class="scope-tag">{evidence.verification}</span>
  </header>

  <p class="scope-note">{evidence.verificationNote}</p>

  {evidence.screenshots && evidence.screenshots.length > 0 && (
    <div class="gallery reveal" aria-label={`${projectTitle} 界面截图`}>
      {evidence.screenshots.map((shot) => (
        <figure class:list={['shot', shot.span ? 'shot-span' : '']}>
          <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" width="1600" height="900" />
          <figcaption>{shot.caption}</figcaption>
        </figure>
      ))}
    </div>
  )}

  {evidence.media && evidence.media.length > 0 && (
    <div class="media-list">
      {evidence.media.map((mediaItem) => (
        <figure class="media-card reveal">
          {hasVideo(mediaItem) ? (
            <video controls playsinline preload="metadata" poster={mediaItem.poster} aria-label={`${projectTitle} 演示视频`}>
              {mediaItem.videoWebm && <source src={mediaItem.videoWebm} type="video/webm" />}
              {mediaItem.videoMp4 && <source src={mediaItem.videoMp4} type="video/mp4" />}
              当前浏览器不能播放视频，可以看右侧的文字说明。
            </video>
          ) : (
            <img src={mediaItem.poster} width="1440" height="900" loading="lazy" alt={mediaItem.caption} />
          )}
          <figcaption>
            <strong>{mediaItem.caption}</strong>
            <details>
              <summary>视频里发生了什么</summary>
              <ol>{mediaItem.transcript.map((line) => <li>{line}</li>)}</ol>
            </details>
          </figcaption>
        </figure>
      ))}
    </div>
  )}

  {evidence.links && evidence.links.length > 0 && (
    <div class="block reveal">
      <h3>相关链接</h3>
      <div class="link-grid">
        {evidence.links.map((link) => (
          <a href={link.url} rel="noopener">
            <strong>{link.label}</strong>
            <small>{link.note}</small>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </div>
  )}

  {evidence.commits.length > 0 && (
    <div class="block reveal">
      <h3>提交记录</h3>
      <div class="commit-table" role="table" aria-label={`${projectTitle} 提交记录`}>
        {evidence.commits.map((commit) => (
          <div class="commit-row" role="row">
            <time role="cell">{commit.date}</time>
            <code role="cell">{commit.hash}</code>
            <div role="cell"><strong>{commit.subject}</strong>{commit.stat && <small>{commit.stat}</small>}</div>
            {commit.url
              ? <a href={commit.url} rel="noopener" aria-label={`打开提交 ${commit.hash}`}>打开 ↗</a>
              : <span class="private-mark">内部仓库</span>}
          </div>
        ))}
      </div>
    </div>
  )}

  {evidence.code && evidence.code.length > 0 && (
    <div class="code-list">
      {evidence.code.map((item) => (
        <article class="code-card reveal">
          <header>
            <div>
              <span class="lang">{item.language}</span>
              <h3>{item.title}</h3>
            </div>
            {item.sourceUrl && <a href={item.sourceUrl} rel="noopener">查看源码 ↗</a>}
          </header>
          <div class="file-bar"><code>{item.file}</code><span>{item.lines}</span></div>
          <pre tabindex="0"><code>{item.code}</code></pre>
          <p>{item.note}</p>
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .showcase {
    padding-block: var(--section);
    border-top: 2px solid var(--line);
  }

  .showcase-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .showcase-header h2 {
    margin-bottom: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .scope-tag {
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--highlight);
    padding: 0.35rem 0.9rem;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 700;
    box-shadow: var(--shadow-sm);
  }

  .scope-note {
    max-width: 52rem;
    margin-bottom: 4rem;
    color: var(--ink-soft);
    font-size: 1rem;
    font-weight: 500;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .shot {
    margin: 0;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .shot-span {
    grid-column: 1 / -1;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface-2);
  }

  .shot figcaption {
    padding: 0.85rem 1.1rem;
    border-top: 2px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.86rem;
    font-weight: 500;
  }

  .media-list {
    display: grid;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .media-card {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 0.5fr);
    margin: 0;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .media-card video,
  .media-card img {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    object-fit: cover;
    background: var(--surface-2);
  }

  .media-card figcaption {
    display: grid;
    align-content: space-between;
    gap: 1.5rem;
    border-left: 2px solid var(--line);
    padding: 1.5rem;
  }

  details {
    font-size: 0.85rem;
  }

  summary {
    color: var(--accent);
    cursor: pointer;
    font-weight: 700;
  }

  details ol {
    margin-top: 0.6rem;
    padding-left: 1.2rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .block {
    margin-bottom: 4rem;
  }

  .block > h3 {
    margin-bottom: 1.4rem;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .link-grid a {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.4rem;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    padding: 1.1rem 3rem 1.1rem 1.1rem;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }

  .link-grid a:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow);
    background: var(--highlight-soft);
  }

  .link-grid small {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .link-grid b {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    color: var(--ink-faint);
  }

  .commit-table {
    border-top: 2px solid var(--line);
  }

  .commit-row {
    display: grid;
    grid-template-columns: 7rem 6rem minmax(0, 1fr) 6rem;
    gap: 1rem;
    align-items: start;
    border-bottom: 2px solid var(--line);
    padding: 1rem 1.1rem;
    background: var(--surface);
  }

  .commit-row time,
  .commit-row code,
  .commit-row a,
  .private-mark {
    font-size: 0.74rem;
    font-weight: 700;
  }

  .commit-row time,
  .commit-row code {
    font-family: var(--mono);
  }

  .commit-row code {
    color: var(--accent);
  }

  .commit-row div {
    display: grid;
  }

  .commit-row small {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .commit-row a {
    color: var(--accent);
    text-decoration: none;
  }

  .private-mark {
    color: var(--ink-faint);
    font-weight: 500;
  }

  .code-list {
    display: grid;
    gap: 3rem;
  }

  .code-card {
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .code-card > header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 2px solid var(--line);
    padding: 1.2rem 1.3rem;
    background: var(--highlight-soft);
  }

  .code-card .lang {
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .code-card h3 {
    margin: 0.4rem 0 0;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
  }

  .code-card > header a {
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
  }

  .file-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 2px solid var(--line);
    padding: 0.7rem 1.3rem;
    color: var(--ink-faint);
    font: 600 0.7rem var(--mono);
    overflow-wrap: anywhere;
  }

  pre {
    margin: 0;
    overflow-x: auto;
    padding: clamp(1rem, 3vw, 1.8rem);
    background: var(--code-bg);
    color: var(--code-ink);
    font: 0.78rem/1.7 var(--mono);
    tab-size: 2;
  }

  .code-card > p {
    max-width: none;
    margin: 0;
    border-top: 2px solid var(--line);
    padding: 1.2rem 1.3rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .gallery,
    .link-grid,
    .media-card {
      grid-template-columns: 1fr;
    }

    .shot-span {
      grid-column: auto;
    }

    .code-card > header {
      align-items: flex-start;
      flex-direction: column;
    }

    .media-card figcaption {
      border-top: 2px solid var(--line);
      border-left: 0;
    }

    .media-card video,
    .media-card img {
      min-height: auto;
    }

    .commit-row {
      grid-template-columns: 1fr auto;
    }

    .commit-row div {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
