---
import type { ProjectEvidence } from '../data/evidence';

interface Props {
  evidence: ProjectEvidence;
  projectTitle: string;
}

const { evidence, projectTitle } = Astro.props;
---

<section class="evidence-dossier container" aria-labelledby="evidence-title">
  <header class="dossier-header">
    <div>
      <p class="kicker">实证存照</p>
      <h2 id="evidence-title">证据卷宗</h2>
    </div>
    <div class="verification-stamp">
      <span class="mono">VERIFICATION</span>
      <strong>{evidence.verification}</strong>
    </div>
  </header>

  <p class="verification-note">{evidence.verificationNote}</p>

  {evidence.screenshots && evidence.screenshots.length > 0 && (
    <div class="screenshot-gallery reveal" aria-label="项目截图证据">
      {evidence.screenshots.map((shot) => (
        <figure class:list={['shot', shot.span ? 'shot-span' : '']}>
          <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" width="1600" height="900" />
          <figcaption>{shot.caption}</figcaption>
        </figure>
      ))}
    </div>
  )}

  {evidence.media && evidence.media.length > 0 && evidence.media.map((mediaItem) => (
    <figure class="evidence-media reveal">
      {mediaItem.videoWebm ? (
        <video controls playsinline preload="metadata" poster={mediaItem.poster} aria-label={`${projectTitle} 演示视频`}>
          {mediaItem.videoMp4 && <source src={mediaItem.videoMp4} type="video/mp4" />}
          <source src={mediaItem.videoWebm} type="video/webm" />
          当前浏览器不能播放视频，请阅读下方演示文字说明。
        </video>
      ) : (
        <img src={mediaItem.poster} width="1440" height="900" loading="lazy" alt={mediaItem.caption} />
      )}
      <figcaption>
        <strong>{mediaItem.caption}</strong>
        <details>
          <summary>视频文字说明</summary>
          <ol>{mediaItem.transcript.map((line) => <li>{line}</li>)}</ol>
        </details>
      </figcaption>
    </figure>
  ))}

  {evidence.links && evidence.links.length > 0 && (
    <div class="source-links reveal">
      <h3>可核之证</h3>
      <div class="source-grid">
        {evidence.links.map((link) => (
          <a href={link.url} rel="noopener">
            <span class="mono">{link.kind.toUpperCase()}</span>
            <strong>{link.label}</strong>
            <small>{link.note}</small>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </div>
  )}

  {evidence.commits.length > 0 && (
    <div class="commit-ledger reveal">
      <h3>提交之迹</h3>
      <div class="commit-table" role="table" aria-label={`${projectTitle} 提交证据`}>
        {evidence.commits.map((commit) => (
          <div class="commit-row" role="row">
            <time role="cell">{commit.date}</time>
            <code role="cell">{commit.hash}</code>
            <div role="cell"><strong>{commit.subject}</strong>{commit.stat && <small>{commit.stat}</small>}</div>
            {commit.url ? <a href={commit.url} rel="noopener" aria-label={`打开提交 ${commit.hash}`}>打开 ↗</a> : <span class="private-mark mono">INTERNAL</span>}
          </div>
        ))}
      </div>
    </div>
  )}

  {evidence.code && evidence.code.length > 0 && (
    <div class="code-evidence">
      {evidence.code.map((item) => (
        <article class="code-case reveal">
          <header>
            <div>
              <span class="mono">{item.language}</span>
              <h3>{item.title}</h3>
            </div>
            {item.sourceUrl && <a href={item.sourceUrl} rel="noopener">查看固定源码 ↗</a>}
          </header>
          <div class="file-bar"><code>{item.file}</code><span>{item.lines}</span></div>
          <pre tabindex="0"><code>{item.code}</code></pre>
          <p>{item.note}</p>
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .evidence-dossier {
    padding-block: var(--section);
    border-top: 1px solid var(--line);
  }

  .dossier-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .dossier-header h2 {
    margin-bottom: 0;
  }

  .verification-stamp {
    display: grid;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: var(--accent-soft);
    padding: 0.7rem 1rem;
    color: var(--ink);
  }

  .verification-stamp span {
    color: var(--accent);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .verification-stamp strong {
    font-size: 0.9rem;
    font-weight: 800;
  }

  .verification-note {
    max-width: 56rem;
    margin-bottom: 3rem;
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .screenshot-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 5rem;
  }

  .shot {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .shot-span {
    grid-column: 1 / -1;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface-2);
  }

  .shot figcaption {
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .screenshot-gallery {
      grid-template-columns: 1fr;
    }

    .shot-span {
      grid-column: auto;
    }
  }

  .evidence-media {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 0.5fr);
    margin: 0 0 5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--ink);
    overflow: hidden;
  }

  .evidence-media video,
  .evidence-media img {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    object-fit: cover;
    background: #0a0c0b;
  }

  .evidence-media figcaption {
    display: grid;
    align-content: space-between;
    gap: 2rem;
    border-left: 1px solid var(--line);
    padding: 1.3rem;
  }

  details {
    font-size: 0.85rem;
  }

  summary {
    color: var(--accent);
    cursor: pointer;
    font-family: var(--mono);
    font-weight: 800;
  }

  details ol {
    padding-left: 1.2rem;
    color: var(--ink-soft);
  }

  .source-links,
  .commit-ledger {
    margin-bottom: 5rem;
  }

  .source-links > h3,
  .commit-ledger > h3 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.7rem, 3vw, 2.7rem);
  }

  .source-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .source-grid a {
    position: relative;
    display: grid;
    min-height: 10rem;
    gap: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1rem 3rem 1rem 1rem;
    text-decoration: none;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1), border-color 200ms, background-color 200ms;
  }

  .source-grid a:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    background: var(--surface-2);
  }

  .source-grid span {
    color: var(--accent);
    font-size: 0.65rem;
    font-weight: 800;
  }

  .source-grid small {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .source-grid b {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--ink-soft);
  }

  .commit-table {
    border-top: 1px solid var(--line);
  }

  .commit-row {
    display: grid;
    grid-template-columns: 7rem 6rem minmax(0, 1fr) 6rem;
    gap: 1rem;
    align-items: start;
    border-bottom: 1px solid var(--line);
    padding: 1rem;
    background: var(--surface);
  }

  .commit-row:nth-child(odd) {
    background: var(--accent-soft);
  }

  .commit-row time,
  .commit-row code,
  .commit-row a,
  .private-mark {
    font: 700 0.72rem var(--mono);
  }

  .commit-row code {
    color: var(--accent);
  }

  .commit-row div {
    display: grid;
  }

  .commit-row small {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .commit-row a {
    color: var(--accent);
    text-decoration: none;
  }

  .private-mark {
    color: var(--ink-faint);
  }

  .code-evidence {
    display: grid;
    gap: 4rem;
  }

  .code-case {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #101410;
    color: #f2f1ea;
    overflow: hidden;
  }

  .code-case > header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .code-case > header span {
    font-size: 0.66rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .code-case h3 {
    margin: 0.35rem 0 0;
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    color: var(--accent-ink);
  }

  .code-case > header a {
    color: var(--accent-ink);
    font: 800 0.72rem var(--mono);
    text-decoration: none;
  }

  .file-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: 0.65rem 1.2rem;
    color: var(--ink-soft);
    font: 700 0.68rem var(--mono);
    overflow-wrap: anywhere;
  }

  pre {
    margin: 0;
    overflow-x: auto;
    padding: clamp(1rem, 3vw, 2rem);
    background: #0a0c0b;
    font: 0.78rem/1.7 var(--mono);
    tab-size: 2;
  }

  .code-case > p {
    max-width: none;
    margin: 0;
    border-top: 1px solid var(--line);
    padding: 1.2rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .dossier-header,
    .code-case > header {
      align-items: flex-start;
      flex-direction: column;
    }

    .evidence-media,
    .source-grid {
      grid-template-columns: 1fr;
    }

    .evidence-media figcaption {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .evidence-media video,
    .evidence-media img {
      min-height: auto;
    }

    .commit-row {
      grid-template-columns: 1fr auto;
    }

    .commit-row div {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
