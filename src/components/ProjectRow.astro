---
import { Image } from 'astro:assets';
import { projectImages, type Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  priority?: boolean;
}

const { project, index, priority = false } = Astro.props;
const cardImage = projectImages[project.slug];
---

<article class="project-card reveal">
  <a class="card-link" href={`/projects/${project.slug}/`} aria-label={`查看项目：${project.title}`}>
    <div class="card-media">
      <Image
        src={cardImage}
        alt={project.title}
        widths={[480, 800, 1200]}
        sizes="(max-width: 900px) 100vw, (max-width: 1180px) 50vw, 566px"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      <span class="card-index mono">{String(index + 1).padStart(2, '0')}</span>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </div>
    <div class="card-body">
      <div class="card-meta mono">
        <span>{project.categoryLabel}</span>
        <span>{project.period}</span>
      </div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <div class="tags" aria-label="技术栈">
        {project.stack.slice(0, 5).map((item) => <span class="tag">{item}</span>)}
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .project-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-lg);
  }

  .card-link {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-2);
    border-bottom: 2px solid var(--line);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .project-card:hover .card-media :global(img) {
    transform: scale(1.04);
  }

  .card-index {
    position: absolute;
    top: 0;
    left: 0;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--highlight);
    padding: 0.25rem 0.6rem;
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .card-arrow {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 1.1rem;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .project-card:hover .card-arrow {
    opacity: 1;
    transform: translateY(0);
  }

  .card-body {
    padding: 1.6rem 1.6rem 1.8rem;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    color: var(--ink-faint);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  h3 {
    margin: 0.8rem 0 0.7rem;
    color: var(--ink);
    line-height: 1.14;
  }

  .card-body p {
    margin-bottom: 1.3rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.7;
    font-weight: 500;
  }

  @media (max-width: 520px) {
    .card-body {
      padding: 1.2rem 1.2rem 1.4rem;
    }
  }
</style>
