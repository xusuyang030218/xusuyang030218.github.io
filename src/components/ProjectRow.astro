---
import { Image } from 'astro:assets';
import { projectImages, type Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  /** Eager-load the first card so the projects grid has no lazy-in pop. */
  priority?: boolean;
}

const { project, index, priority = false } = Astro.props;
const cardImage = projectImages[project.slug];
---

<article class="project-card reveal">
  <a class="card-link" href={`/projects/${project.slug}/`} aria-label={`查看项目：${project.title}`}>
    <div class="card-media">
      <Image
        src={cardImage}
        alt={project.title}
        widths={[480, 800, 1200]}
        sizes="(max-width: 900px) 100vw, (max-width: 1180px) 50vw, 566px"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
      <span class="card-index mono">{String(index + 1).padStart(2, '0')}</span>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </div>
    <div class="card-body">
      <div class="card-meta mono">
        <span>{project.categoryLabel}</span>
        <span>{project.period}</span>
      </div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <div class="tags" aria-label="技术栈">
        {project.stack.slice(0, 5).map((item) => <span class="tag">{item}</span>)}
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1), border-color 240ms, box-shadow 240ms;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
  }

  .card-link {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-2);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) brightness(0.9);
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 500ms;
  }

  .project-card:hover .card-media :global(img) {
    transform: scale(1.045);
    filter: saturate(1) brightness(1);
  }

  .card-index {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    border: 1px solid rgba(242, 241, 234, 0.3);
    border-radius: var(--radius-pill);
    background: rgba(12, 15, 13, 0.55);
    backdrop-filter: blur(6px);
    padding: 0.2rem 0.6rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .card-arrow {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(242, 241, 234, 0.3);
    border-radius: 50%;
    background: rgba(12, 15, 13, 0.55);
    backdrop-filter: blur(6px);
    color: var(--ink);
    font-size: 1.1rem;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 220ms ease, transform 220ms ease, background-color 220ms, color 220ms;
  }

  .project-card:hover .card-arrow {
    opacity: 1;
    transform: translateY(0);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .card-body {
    padding: 1.4rem 1.4rem 1.6rem;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    color: var(--ink-faint);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  h3 {
    margin: 0.7rem 0 0.6rem;
    color: var(--ink);
    line-height: 1.14;
  }

  .card-body p {
    margin-bottom: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    font-weight: 500;
  }

  @media (max-width: 520px) {
    .card-body {
      padding: 1.1rem 1.1rem 1.3rem;
    }
  }
</style>
