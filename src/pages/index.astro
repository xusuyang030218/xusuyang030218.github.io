---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { featuredProjects } from '../data/projects';

const marqueeItems = ['企业前端重构', 'LLM 应用', 'RAG 检索', 'AI Agent', 'Java 全栈', '工程化交付', '遗留系统治理', 'Agent Skills'];
---

<BaseLayout title="徐苏洋" description="徐苏洋的开发者作品站，记录企业前端重构、AI Agent、RAG、Java 全栈与自研 Agent Skills。">
  <section class="hero container">
    <div class="hero-copy">
      <p class="kicker">Software · Agent · Refactoring</p>
      <h1>把复杂系统<br /><span class="accent">做扎实。</span></h1>
      <p class="hero-lede">从企业前端重构到 Agent 工程，记录问题、决策与可落地的交付。</p>
      <div class="hero-actions">
        <a class="button" href="/projects/">查看项目</a>
        <a class="button secondary" href="mailto:2307456010@qq.com">发送邮件</a>
      </div>
    </div>
    <aside class="hero-plate" aria-label="基本信息">
      <p class="plate-name mono">PROFILE</p>
      <dl>
        <div><dt>身份</dt><dd>2027 届软件工程本科生</dd></div>
        <div><dt>院校</dt><dd>大连东软信息学院</dd></div>
        <div><dt>方向</dt><dd>LLM 应用 · Java 全栈 · 前端重构</dd></div>
        <div><dt>成果</dt><dd>8 个案例 · 30 余项竞赛获奖</dd></div>
      </dl>
      <div class="plate-links">
        <a href="mailto:2307456010@qq.com">邮箱</a>
        <a href="https://github.com/xusuyang030218" rel="me">GitHub</a>
        <a href="https://gitee.com/anhuiwuhu_xsy" rel="me">Gitee</a>
      </div>
    </aside>
  </section>

  <section class="marquee" aria-label="关注方向">
    <div class="marquee-track">
      <div class="marquee-group">
        {marqueeItems.map((item) => <><span>{item}</span><i aria-hidden="true">·</i></>)}
      </div>
      <div class="marquee-group" aria-hidden="true">
        {marqueeItems.map((item) => <><span>{item}</span><i aria-hidden="true">·</i></>)}
      </div>
    </div>
  </section>

  <section class="stats" aria-label="核心数据">
    <div class="container stats-grid">
      <div><strong>40+</strong><span>DTS 可归属功能与修复提交</span></div>
      <div><strong>20</strong><span>企业项目测试用例</span></div>
      <div><strong>18</strong><span>WorkBuddy 原型迭代</span></div>
      <div><strong>35</strong><span>学科竞赛获奖项次</span></div>
    </div>
  </section>

  <section class="section container thesis">
    <div class="thesis-head reveal">
      <p class="kicker">行事之纲</p>
      <h2>比"会多少技术"更重要的，是知道什么能落地。</h2>
    </div>
    <div class="thesis-notes reveal">
      <p>我关注模型能力进入真实业务后的工程问题：权限、审计、流式输出、失败降级、数据边界和交付验证。</p>
      <p>面对遗留系统，我先建立行为基线，再决定修复、重构或迁移。所有精确指标都应该能追溯到脚本、环境和报告。</p>
    </div>
  </section>

  <section class="section projects-section">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="kicker">代表之作</p>
          <h2>项目不是技术清单，是一连串有取舍的决定。</h2>
        </div>
        <a class="button secondary" href="/projects/">查看全部项目</a>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project, index) => <ProjectRow project={project} index={index} priority={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section container dts-feature">
    <div class="dts-title reveal">
      <span class="mono">CASE / DTS DASHBOARD</span>
      <h2>版本升级开发<br />与前端重构</h2>
    </div>
    <div class="flow-diagram reveal" aria-label="DTS 重构流程">
      <div><b class="mono">01</b><span>复现</span><small>用户行为与数据样本</small></div>
      <div><b class="mono">02</b><span>定位</span><small>请求、状态、映射与 DOM</small></div>
      <div><b class="mono">03</b><span>重构</span><small>收敛双链路与组件边界</small></div>
      <div><b class="mono">04</b><span>验证</span><small>回归、打包与必要时回退</small></div>
    </div>
    <div class="dts-copy reveal">
      <p>在 Vue 2、Element UI、ECharts 与 bootstrapTable 构成的遗留系统中，我处理的不是单一页面，而是筛选、导出、引用、图表和表格之间的完整数据路径。</p>
      <a class="button secondary" href="/projects/dts-dashboard/">阅读案例</a>
    </div>
  </section>

  <section class="section skills-band">
    <div class="container skills-layout">
      <div class="skills-intro reveal">
        <p class="kicker">技艺沉淀</p>
        <h2>把个人经验写成可复用的执行协议。</h2>
        <p class="lede">从遗留系统重构、人工代码检视到文档摄取与 E2E 测试，每个 Skill 都明确输入、步骤、产出与失败边界。</p>
      </div>
      <div class="skill-ledger reveal">
        <a href="/projects/refactor-compass/"><span>Refactor Compass</span><small>遗留系统现代化</small><b class="mono">01</b></a>
        <a href="/projects/agent-skills/"><span>Diff Review Report</span><small>人工代码检视</small><b class="mono">02</b></a>
        <a href="/projects/agent-skills/"><span>Document Intake</span><small>多格式文档摄取</small><b class="mono">03</b></a>
        <a href="/projects/agent-skills/"><span>Test Workflow</span><small>用例生成与执行</small><b class="mono">04</b></a>
      </div>
    </div>
  </section>

  <section class="section container closing">
    <div class="closing-copy reveal">
      <p class="mono">OPEN TO INTERNSHIP & COLLABORATION</p>
      <h2>正在寻找能把 AI 与工程质量同时当真的团队。</h2>
    </div>
    <a class="button" href="mailto:2307456010@qq.com">发送邮件</a>
  </section>
</BaseLayout>

<style>
  /* Hero — asymmetric split */
  .hero {
    display: grid;
    min-height: calc(100dvh - 68px);
    grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.5fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(3rem, 7vh, 5.5rem);
  }

  .hero h1 {
    max-width: 12ch;
    margin-bottom: 1.4rem;
  }

  .hero h1 .accent {
    color: var(--accent);
  }

  .hero-lede {
    max-width: 30rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.8vw, 1.28rem);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero-plate {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .plate-name {
    margin-bottom: 1.2rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .hero-plate dl {
    margin: 0;
  }

  .hero-plate dl div {
    border-top: 1px solid var(--line);
    padding: 0.85rem 0;
  }

  .hero-plate dt {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .hero-plate dd {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .plate-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }

  .plate-links a {
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.7rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .plate-links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: var(--accent);
    color: var(--accent-ink);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0.9rem 1rem;
    white-space: nowrap;
  }

  .marquee-group span {
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    font-weight: 800;
  }

  .marquee-group i {
    font-style: normal;
    opacity: 0.5;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Stats */
  .stats {
    border-bottom: 1px solid var(--line);
    background: var(--bg-raise);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .stats-grid div {
    display: grid;
    min-height: 8rem;
    align-content: center;
    border-left: 1px solid var(--line);
    padding: 1.4rem;
  }

  .stats-grid div:last-child {
    border-right: 1px solid var(--line);
  }

  .stats-grid strong {
    color: var(--accent);
    font: 800 clamp(2rem, 4vw, 3.4rem) var(--mono);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stats-grid span {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* Thesis */
  .thesis {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .thesis h2 {
    margin-bottom: 0;
  }

  .thesis-notes {
    border-left: 2px solid var(--accent);
    padding-left: 1.4rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .thesis-notes p {
    margin-bottom: 1rem;
  }

  .thesis-notes p:last-child {
    margin-bottom: 0;
  }

  /* Projects */
  .projects-section {
    border-block: 1px solid var(--line);
    background: var(--bg-raise);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-heading h2 {
    max-width: 22ch;
    margin-bottom: 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  /* DTS feature */
  .dts-feature {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .dts-title .mono {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .dts-title h2 {
    margin-top: 1rem;
  }

  .flow-diagram {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
  }

  .flow-diagram div {
    display: grid;
    min-height: 13rem;
    align-content: space-between;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1rem;
    transition: border-color 220ms ease, transform 220ms ease;
  }

  .flow-diagram div:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .flow-diagram b {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .flow-diagram span {
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    font-weight: 800;
  }

  .flow-diagram small {
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .dts-copy {
    grid-column: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .dts-copy p {
    color: var(--ink-soft);
    font-weight: 500;
  }

  /* Skills band */
  .skills-band {
    border-block: 1px solid var(--line);
    background: var(--bg-raise);
  }

  .skills-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .skills-intro {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .skills-band .lede {
    color: var(--ink-soft);
  }

  .skill-ledger {
    display: grid;
    gap: 0.9rem;
  }

  .skill-ledger a {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.3rem 1.2rem;
    text-decoration: none;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1), border-color 200ms, background-color 200ms;
  }

  .skill-ledger a:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    background: var(--surface-2);
  }

  .skill-ledger span {
    font-size: 1.15rem;
    font-weight: 800;
  }

  .skill-ledger small {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .skill-ledger b {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
  }

  /* Closing */
  .closing {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
  }

  .closing h2 {
    max-width: 20ch;
    margin-bottom: 0;
  }

  .closing-copy .mono {
    margin-bottom: 1rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  @media (max-width: 900px) {
    .hero,
    .thesis,
    .dts-feature,
    .skills-layout {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .dts-copy {
      grid-column: 1;
    }

    .skills-intro {
      position: static;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats-grid div:nth-child(3),
    .stats-grid div:nth-child(4) {
      border-top: 1px solid var(--line);
    }

    .flow-diagram {
      grid-template-columns: repeat(2, 1fr);
    }

    .flow-diagram div {
      min-height: 9rem;
    }

    .dts-copy,
    .closing {
      align-items: flex-start;
      flex-direction: column;
    }

    .section-heading {
      flex-direction: column;
      align-items: flex-start;
    }

    .skill-ledger a {
      grid-template-columns: 1fr auto;
    }

    .skill-ledger small {
      grid-column: 1;
      grid-row: 2;
    }

    .skill-ledger b {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
