---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { featuredProjects } from '../data/projects';
import { stackGroups } from '../data/stack';
import { notes } from '../data/notes';

const recentNotes = [...notes].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);

const marqueeItems = ['LLM 应用', 'AI Agent', 'Java 全栈', '前端重构', 'RAG 检索', 'Agent Skills', '工程化交付', '遗留系统治理'];
---

<BaseLayout title="徐苏洋" description="徐苏洋的开发者作品站，记录 AI Agent、RAG、Java 全栈与前端重构。">
  <section class="hero container" data-hero>
    <canvas class="hero-particles" data-particles aria-hidden="true"></canvas>
    <div class="hero-copy">
      <p class="badge" data-badge><span class="badge-dot"></span>Open to opportunities · 可合作交流</p>
      <p class="kicker" data-hero-item>Software · Agent · Refactoring</p>
      <h1 data-hero-item>把复杂系统<br /><span class="accent">做扎实。</span></h1>
      <p class="hero-lede" data-hero-item>从企业前端重构到 Agent 工程，记录问题、决策与可落地的交付。</p>
      <div class="hero-actions" data-hero-item>
        <a class="button" href="/projects/">查看项目</a>
        <a class="button secondary" href="mailto:2307456010@qq.com">发送邮件</a>
      </div>
    </div>
    <aside class="hero-plate" data-hero-item aria-label="基本信息">
      <p class="plate-name mono">PROFILE</p>
      <dl>
        <div><dt>身份</dt><dd>2027 届软件工程本科生</dd></div>
        <div><dt>院校</dt><dd>大连东软信息学院</dd></div>
        <div><dt>方向</dt><dd>LLM 应用 · Java 全栈 · 前端重构</dd></div>
        <div><dt>成果</dt><dd>8 个案例 · 30 余项竞赛获奖</dd></div>
      </dl>
      <div class="plate-links">
        <a href="mailto:2307456010@qq.com">邮箱</a>
        <a href="https://github.com/xusuyang030218" rel="me">GitHub</a>
        <a href="https://gitee.com/anhuiwuhu_xsy" rel="me">Gitee</a>
      </div>
    </aside>
  </section>

  <section class="marquee" aria-label="关注方向">
    <div class="marquee-track">
      <div class="marquee-group">
        {marqueeItems.map((item) => <><span>{item}</span><i aria-hidden="true">·</i></>)}
      </div>
      <div class="marquee-group" aria-hidden="true">
        {marqueeItems.map((item) => <><span>{item}</span><i aria-hidden="true">·</i></>)}
      </div>
    </div>
  </section>

  <section class="stats" aria-label="核心数据">
    <div class="container stats-grid">
      <div><strong>40+</strong><span>DTS 功能与修复提交</span></div>
      <div><strong>20</strong><span>企业项目测试用例</span></div>
      <div><strong>18</strong><span>WorkBuddy 原型迭代</span></div>
      <div><strong>35</strong><span>学科竞赛获奖项次</span></div>
    </div>
  </section>

  <section class="section container thesis">
    <div class="thesis-head reveal">
      <p class="kicker">行事之纲</p>
      <h2>知道什么能落地。</h2>
    </div>
    <div class="thesis-notes reveal">
      <p>关注模型能力进入真实业务后的工程问题：权限、审计、流式输出、失败降级、数据边界。</p>
      <p>面对遗留系统，先建立行为基线，再决定修复、重构或迁移。</p>
    </div>
  </section>

  <section class="section projects-section">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="kicker">代表之作</p>
          <h2>项目是一连串有取舍的决定。</h2>
        </div>
        <a class="button secondary" href="/projects/">查看全部</a>
      </div>
      <div class="project-grid" data-stagger>
        {featuredProjects.map((project, index) => <ProjectRow project={project} index={index} priority={index === 0} />)}
      </div>
    </div>
  </section>

  <section class="section container dts-feature">
    <div class="dts-title reveal">
      <span class="mono">CASE / DTS DASHBOARD</span>
      <h2>版本升级开发<br />与前端重构</h2>
    </div>
    <div class="flow-diagram reveal" data-stagger aria-label="DTS 重构流程">
      <div><b class="mono">01</b><span>复现</span><small>用户行为与数据样本</small></div>
      <div><b class="mono">02</b><span>定位</span><small>请求、状态、映射与 DOM</small></div>
      <div><b class="mono">03</b><span>重构</span><small>收敛双链路与组件边界</small></div>
      <div><b class="mono">04</b><span>验证</span><small>回归、打包与回退</small></div>
    </div>
    <div class="dts-copy reveal">
      <p>在 Vue 2 + Element UI + ECharts 构成的遗留系统中，处理的是筛选、导出、引用、图表和表格之间的完整数据路径。</p>
      <a class="button secondary" href="/projects/dts-dashboard/">阅读案例</a>
    </div>
  </section>

  <section class="section container stack-section">
    <div class="stack-head reveal">
      <p class="kicker">技术栈</p>
      <h2>用过的，而不是听过的。</h2>
      <p class="lede">每一项都标注了它出现在哪些案例里，可以直接翻到对应项目核对。</p>
    </div>
    <div class="stack-grid" data-stagger>
      {stackGroups.map((group) => (
        <article class="stack-card reveal">
          <h3>{group.title}</h3>
          <p class="stack-summary">{group.summary}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <span class="stack-name">{item.name}</span>
                <span class="stack-projects mono">{item.projects.join(' · ')}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section notes-band">
    <div class="container notes-layout">
      <div class="notes-intro reveal">
        <p class="kicker">工程随笔</p>
        <h2>把做过的事写清楚。</h2>
        <p class="lede">一次提交、一段实现、一个原型，各自留下的判断。</p>
        <a class="button secondary" href="/notes/">全部随笔</a>
      </div>
      <div class="notes-list reveal" data-stagger>
        {recentNotes.map((note) => (
          <a href={`/notes/${note.slug}/`}>
            <time class="mono" datetime={note.date}>{note.date}</time>
            <strong>{note.title}</strong>
            <small>{note.summary}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section skills-band">
    <div class="container skills-layout">
      <div class="skills-intro reveal">
        <p class="kicker">技艺沉淀</p>
        <h2>把经验写成可复用的执行协议。</h2>
        <p class="lede">每个 Skill 都明确输入、步骤、产出与失败边界。</p>
      </div>
      <div class="skill-ledger reveal" data-stagger>
        <a href="/projects/refactor-compass/"><span>Refactor Compass</span><small>遗留系统现代化</small><b class="mono">01</b></a>
        <a href="/projects/agent-skills/"><span>Diff Review Report</span><small>人工代码检视</small><b class="mono">02</b></a>
        <a href="/projects/agent-skills/"><span>Document Intake</span><small>多格式文档摄取</small><b class="mono">03</b></a>
        <a href="/projects/agent-skills/"><span>Test Workflow</span><small>用例生成与执行</small><b class="mono">04</b></a>
      </div>
    </div>
  </section>

  <section class="section container closing">
    <div class="closing-copy reveal">
      <p class="mono">OPEN TO INTERNSHIP & COLLABORATION</p>
      <h2>正在寻找把 AI 与工程质量同时当真的团队。</h2>
    </div>
    <a class="button" href="mailto:2307456010@qq.com">发送邮件</a>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .badge {
    display: inline-flex;
    align-items: center;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    padding: 0.4rem 0.9rem;
    font-size: 0.76rem;
    font-weight: 700;
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.8rem;
  }

  .hero {
    position: relative;
    display: grid;
    min-height: calc(100dvh - 72px);
    grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.5fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(3rem, 7vh, 5.5rem);
  }

  .hero-particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero > *:not(.hero-particles) {
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    max-width: 12ch;
    margin-bottom: 1.6rem;
  }

  .hero h1 .accent {
    color: var(--accent);
  }

  .hero-lede {
    max-width: 30rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.8vw, 1.28rem);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .hero-plate {
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    padding: 1.8rem;
    box-shadow: var(--shadow);
  }

  .plate-name {
    margin-bottom: 1.4rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .hero-plate dl {
    margin: 0;
  }

  .hero-plate dl div {
    border-top: 2px solid var(--line);
    padding: 0.9rem 0;
  }

  .hero-plate dt {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .hero-plate dd {
    margin: 0.3rem 0 0;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .plate-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .plate-links a {
    border: 2px solid var(--line);
    border-radius: 0;
    padding: 0.3rem 0.7rem;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
    background: var(--highlight);
    box-shadow: var(--shadow-sm);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .plate-links a:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow);
  }

  /* Marquee — amber band */
  .marquee {
    overflow: hidden;
    border-block: 2px solid var(--line);
    background: var(--highlight);
    color: var(--highlight-ink);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 28s linear infinite;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1rem 1rem;
    white-space: nowrap;
  }

  .marquee-group span {
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    font-weight: 800;
  }

  .marquee-group i {
    font-style: normal;
    opacity: 0.5;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Stats — bordered cells */
  .stats {
    border-bottom: 2px solid var(--line);
    background: var(--bg-raise);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .stats-grid div {
    display: grid;
    min-height: 9rem;
    align-content: center;
    border-left: 2px solid var(--line);
    padding: 1.6rem;
  }

  .stats-grid div:last-child {
    border-right: 2px solid var(--line);
  }

  .stats-grid strong {
    color: var(--accent);
    font: 800 clamp(2rem, 4vw, 3.4rem) var(--mono);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .stats-grid span {
    margin-top: 0.7rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* Thesis */
  .thesis {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .thesis h2 {
    margin-bottom: 0;
  }

  .thesis-notes {
    border-left: 3px solid var(--accent);
    padding-left: 1.6rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .thesis-notes p {
    margin-bottom: 1.2rem;
  }

  .thesis-notes p:last-child {
    margin-bottom: 0;
  }

  /* Projects */
  .projects-section {
    border-block: 2px solid var(--line);
    /* 抬升带：斜向细纹 + 内侧顶光，和纯平底色区分开 */
    background-color: var(--bg-raise);
    background-image:
      repeating-linear-gradient(
        135deg,
        rgba(10, 10, 10, 0.014) 0 1px,
        transparent 1px 11px
      );
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-heading h2 {
    max-width: 22ch;
    margin-bottom: 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  /* DTS feature */
  .dts-feature {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .dts-title .mono {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .dts-title h2 {
    margin-top: 1.2rem;
  }

  .flow-diagram {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .flow-diagram div {
    display: grid;
    min-height: 13rem;
    align-content: space-between;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    padding: 1.2rem;
    box-shadow: var(--shadow-sm);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .flow-diagram div:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow);
  }

  .flow-diagram b {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .flow-diagram span {
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    font-weight: 800;
  }

  .flow-diagram small {
    color: var(--ink-soft);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .dts-copy {
    grid-column: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .dts-copy p {
    color: var(--ink-soft);
    font-weight: 500;
  }

  /* Skills band */
  .skills-band {
    border-block: 2px solid var(--line);
    /* 最深一层，收束页面尾部 */
    background-color: var(--bg-deep);
    background-image:
      radial-gradient(ellipse 70% 100% at 100% 0%, rgba(27, 94, 63, 0.10), transparent 58%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
  }

  .skills-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .skills-intro {
    position: sticky;
    top: 6rem;
    align-self: start;
  }

  .skills-band .lede {
    color: var(--ink-soft);
  }

  .skill-ledger {
    display: grid;
    gap: 1rem;
  }

  .skill-ledger a {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    align-items: center;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    padding: 1.4rem 1.3rem;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 160ms ease, box-shadow 160ms ease, background-color 160ms ease;
  }

  .skill-ledger a:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow);
    background: var(--highlight-soft);
  }

  .skill-ledger span {
    font-size: 1.15rem;
    font-weight: 800;
  }

  .skill-ledger small {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .skill-ledger b {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
  }

  /* Tech stack */
  .stack-head {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .stack-head h2 {
    margin-bottom: 1rem;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.25rem;
  }

  .stack-card {
    border: 2px solid var(--line);
    box-shadow: var(--shadow);
    background-color: var(--surface);
    background-image: var(--surface-sheen);
    padding: 1.4rem;
  }

  .stack-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }

  .stack-summary {
    margin-bottom: 1.1rem;
    color: var(--ink-faint);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .stack-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stack-card li {
    display: grid;
    gap: 0.15rem;
    border-top: 1px solid var(--line-soft);
    padding: 0.6rem 0;
  }

  .stack-name {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .stack-projects {
    color: var(--ink-faint);
    font-size: 0.68rem;
  }

  /* Notes band */
  .notes-band {
    border-block: 2px solid var(--line);
    /* 网格纹，呼应"笔记本"语义 */
    background-color: var(--bg-raise);
    background-image:
      linear-gradient(rgba(10, 10, 10, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(10, 10, 10, 0.03) 1px, transparent 1px);
    background-size: 30px 30px, 30px 30px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .notes-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .notes-intro {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .notes-intro h2 {
    margin-bottom: 1rem;
  }

  .notes-intro .lede {
    margin-bottom: 1.6rem;
  }

  .notes-list {
    display: grid;
    gap: 1rem;
  }

  .notes-list a {
    display: grid;
    gap: 0.4rem;
    border: 2px solid var(--line);
    box-shadow: var(--shadow);
    background-color: var(--surface);
    background-image: var(--surface-sheen);
    padding: 1.2rem 1.3rem;
    text-decoration: none;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .notes-list a:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg);
  }

  .notes-list time {
    color: var(--accent);
    font-size: 0.7rem;
  }

  .notes-list strong {
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .notes-list small {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  /* Closing */
  .closing {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
  }

  .closing h2 {
    max-width: 20ch;
    margin-bottom: 0;
  }

  .closing-copy .mono {
    margin-bottom: 1.2rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  @media (max-width: 900px) {
    .hero,
    .thesis,
    .dts-feature,
    .skills-layout,
    .notes-layout {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .dts-copy {
      grid-column: 1;
    }

    .skills-intro,
    .notes-intro {
      position: static;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats-grid div:nth-child(3),
    .stats-grid div:nth-child(4) {
      border-top: 2px solid var(--line);
    }

    .flow-diagram {
      grid-template-columns: repeat(2, 1fr);
    }

    .flow-diagram div {
      min-height: 9rem;
    }

    .dts-copy,
    .closing {
      align-items: flex-start;
      flex-direction: column;
    }

    .section-heading {
      flex-direction: column;
      align-items: flex-start;
    }

    .skill-ledger a {
      grid-template-columns: 1fr auto;
    }

    .skill-ledger small {
      grid-column: 1;
      grid-row: 2;
    }

    .skill-ledger b {
      grid-column: 2;
