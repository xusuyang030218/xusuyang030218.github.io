---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { featuredProjects } from '../data/projects';
---

<BaseLayout title="徐苏洋" description="徐苏洋的开发者作品站，记录企业前端重构、AI Agent、RAG、Java 全栈与自研 Agent Skills。">
  <section class="hero container">
    <div class="hero-copy">
      <p class="kicker">Software · Agent · Refactoring</p>
      <h1>把复杂系统<br /><em>做成证据。</em></h1>
      <p class="hero-lede">从企业前端重构到 Agent 工程，记录问题、决策与可验证交付。</p>
      <div class="hero-actions">
        <a class="button" href="/projects/">查看项目</a>
        <a class="button secondary" href="mailto:2307456010@qq.com">发送邮件</a>
      </div>
    </div>
    <aside class="hero-plate" aria-label="个人概览">
      <div class="portrait-frame">
        <img src="/avatar.png" width="640" height="640" alt="徐苏洋的公开头像" fetchpriority="high" />
      </div>
      <dl>
        <div><dt>当前身份</dt><dd>2027 届软件工程本科生</dd></div>
        <div><dt>工程方向</dt><dd>LLM 应用 · Java 全栈 · 前端重构</dd></div>
        <div><dt>公开成果</dt><dd>8 个案例 · 30 余项竞赛成果</dd></div>
      </dl>
    </aside>
  </section>

  <section class="signal-strip" aria-label="核心能力">
    <div class="container signal-grid">
      <div><strong>40+</strong><span>DTS 可归属功能与修复提交</span></div>
      <div><strong>20</strong><span>企业项目测试用例</span></div>
      <div><strong>18</strong><span>WorkBuddy 原型迭代</span></div>
      <div><strong>35</strong><span>学科竞赛获奖项次</span></div>
    </div>
  </section>

  <section class="section container thesis reveal">
    <div>
      <p class="kicker">工作方法</p>
      <h2>比“会多少技术”更重要的，是知道何时相信证据。</h2>
    </div>
    <div class="thesis-notes">
      <p>我关注模型能力进入真实业务后的工程问题：权限、审计、流式输出、失败降级、数据边界和交付验证。</p>
      <p>面对遗留系统，我先建立行为基线，再决定修复、重构或迁移。所有精确指标都应该能追溯到脚本、环境和报告。</p>
    </div>
  </section>

  <section class="section projects-section">
    <div class="container">
      <div class="section-heading">
        <p class="kicker">精选案例</p>
        <h2>项目不是技术清单，是一连串有取舍的决定。</h2>
        <a href="/projects/">查看全部项目</a>
      </div>
      <div class="project-list">
        {featuredProjects.map((project, index) => <ProjectRow project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section container dts-feature reveal">
    <div class="dts-title">
      <span class="mono">CASE / DTS DASHBOARD</span>
      <h2>版本升级开发<br />与前端重构</h2>
    </div>
    <div class="flow-diagram" aria-label="DTS 重构流程">
      <div><b>01</b><span>复现</span><small>用户行为与数据样本</small></div>
      <div><b>02</b><span>定位</span><small>请求、状态、映射与 DOM</small></div>
      <div><b>03</b><span>重构</span><small>收敛双链路与组件边界</small></div>
      <div><b>04</b><span>验证</span><small>回归、打包与必要时回退</small></div>
    </div>
    <div class="dts-copy">
      <p>在 Vue 2、Element UI、ECharts 与 bootstrapTable 构成的遗留系统中，我处理的不是单一页面，而是筛选、导出、引用、图表和表格之间的完整数据路径。</p>
      <a class="button secondary" href="/projects/dts-dashboard/">阅读案例</a>
    </div>
  </section>

  <section class="section skills-band">
    <div class="container skills-layout">
      <div class="skills-intro reveal">
        <p class="kicker">Agent Skills</p>
        <h2>把个人经验写成可复用的执行协议。</h2>
        <p class="lede">从遗留系统重构、人工代码检视到文档摄取与 E2E 测试，每个 Skill 都明确输入、步骤、证据与失败边界。</p>
      </div>
      <div class="skill-ledger reveal">
        <a href="/projects/refactor-compass/"><span>Refactor Compass</span><small>遗留系统现代化</small><b>01</b></a>
        <a href="/projects/agent-skills/"><span>Diff Review Report</span><small>人工代码检视</small><b>02</b></a>
        <a href="/projects/agent-skills/"><span>Document Intake</span><small>多格式文档摄取</small><b>03</b></a>
        <a href="/projects/agent-skills/"><span>Test Workflow</span><small>用例生成与执行</small><b>04</b></a>
      </div>
    </div>
  </section>

  <section class="section container closing reveal">
    <div>
      <p class="mono">OPEN TO INTERNSHIP & COLLABORATION</p>
      <h2>正在寻找能把 AI 与工程质量同时当真的团队。</h2>
    </div>
    <a class="button" href="mailto:2307456010@qq.com">发送邮件</a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: calc(100dvh - 73px);
    grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.55fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    padding-block: clamp(3rem, 8vh, 6rem);
  }

  .hero h1 {
    max-width: 10ch;
    margin-bottom: 1.5rem;
  }

  .hero h1 em {
    display: inline-block;
    color: var(--accent-dark);
    font-style: italic;
    line-height: 1.12;
    padding-bottom: 0.12em;
  }

  .hero-lede {
    max-width: 27rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-plate {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 1px solid var(--line);
    padding-left: clamp(1.25rem, 3vw, 2.5rem);
  }

  .portrait-frame {
    position: relative;
    width: min(100%, 18rem);
    aspect-ratio: 1;
    margin-bottom: 1.6rem;
    overflow: hidden;
    background: var(--paper-deep);
    filter: grayscale(1) contrast(1.06);
  }

  .portrait-frame::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 60%, rgba(170, 100, 31, 0.3));
    content: "";
    mix-blend-mode: multiply;
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  dl {
    margin: 0;
  }

  dl div {
    border-top: 1px solid var(--line);
    padding: 0.8rem 0;
  }

  dt {
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  dd {
    margin: 0.18rem 0 0;
    font-size: 0.92rem;
    font-weight: 650;
  }

  .signal-strip {
    border-block: 1px solid var(--ink);
    background: var(--ink);
    color: var(--white);
  }

  .signal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .signal-grid div {
    display: grid;
    min-height: 8rem;
    align-content: center;
    border-left: 1px solid rgba(247, 246, 241, 0.3);
    padding: 1.2rem;
  }

  .signal-grid div:last-child {
    border-right: 1px solid rgba(247, 246, 241, 0.3);
  }

  .signal-grid strong {
    color: #df9a51;
    font: 750 clamp(2rem, 4vw, 3.6rem) var(--mono);
    line-height: 1;
  }

  .signal-grid span {
    margin-top: 0.6rem;
    font-size: 0.78rem;
  }

  .thesis {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .thesis h2 {
    margin-bottom: 0;
  }

  .thesis-notes {
    border-left: 3px solid var(--accent);
    padding-left: 1.4rem;
    color: var(--ink-soft);
  }

  .projects-section {
    background: rgba(247, 246, 241, 0.42);
  }

  .section-heading {
    display: grid;
    max-width: 54rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .section-heading h2 {
    margin-bottom: 1.5rem;
  }

  .section-heading > a {
    width: fit-content;
    color: var(--accent-dark);
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .dts-feature {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .dts-title span {
    color: var(--accent-dark);
    font-size: 0.75rem;
  }

  .dts-title h2 {
    margin-top: 1rem;
  }

  .flow-diagram {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--ink);
  }

  .flow-diagram div {
    display: grid;
    min-height: 15rem;
    align-content: space-between;
    border-right: 1px solid var(--line);
    padding: 1rem;
  }

  .flow-diagram div:last-child {
    border-right: 0;
  }

  .flow-diagram b {
    color: var(--accent-dark);
    font: 700 0.75rem var(--mono);
  }

  .flow-diagram span {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: 750;
  }

  .flow-diagram small {
    color: var(--ink-soft);
    font-size: 0.68rem;
  }

  .dts-copy {
    grid-column: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .dts-copy p {
    color: var(--ink-soft);
  }

  .skills-band {
    border-block: 1px solid var(--ink);
    background: var(--paper-deep);
  }

  .skills-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .skills-intro {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .skill-ledger {
    border-top: 1px solid var(--ink);
  }

  .skill-ledger a {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    align-items: center;
    border-bottom: 1px solid var(--ink);
    padding: 1.4rem 0;
    text-decoration: none;
  }

  .skill-ledger a:hover span {
    color: var(--accent-dark);
  }

  .skill-ledger span {
    font-size: 1.2rem;
    font-weight: 750;
  }

  .skill-ledger small {
    color: var(--ink-soft);
  }

  .skill-ledger b {
    color: var(--accent-dark);
    font: 700 0.78rem var(--mono);
  }

  .closing {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
  }

  .closing h2 {
    max-width: 18ch;
    margin-bottom: 0;
  }

  .closing p {
    color: var(--accent-dark);
    font-size: 0.75rem;
  }

  @media (max-width: 900px) {
    .hero,
    .thesis,
    .dts-feature,
    .skills-layout {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .hero-plate {
      display: grid;
      grid-template-columns: 10rem 1fr;
      gap: 1.5rem;
      border-top: 1px solid var(--line);
      border-left: 0;
      padding: 1.5rem 0 0;
    }

    .portrait-frame {
      margin: 0;
    }

    .dts-copy {
      grid-column: 1;
    }

    .skills-intro {
      position: static;
    }
  }

  @media (max-width: 680px) {
    .hero-plate {
      grid-template-columns: 1fr;
    }

    .portrait-frame {
      width: 10rem;
    }

    .signal-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .signal-grid div:nth-child(3),
    .signal-grid div:nth-child(4) {
      border-top: 1px solid rgba(247, 246, 241, 0.3);
    }

    .flow-diagram {
      grid-template-columns: repeat(2, 1fr);
    }

    .flow-diagram div {
      min-height: 10rem;
      border-bottom: 1px solid var(--line);
    }

    .dts-copy,
    .closing {
      align-items: flex-start;
      flex-direction: column;
    }

    .skill-ledger a {
      grid-template-columns: 1fr auto;
    }

    .skill-ledger small {
      grid-column: 1;
      grid-row: 2;
    }

    .skill-ledger b {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
