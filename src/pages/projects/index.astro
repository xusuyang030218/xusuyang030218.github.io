---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { projects, categoryLabels, type ProjectCategory } from '../../data/projects';

const categories = Object.entries(categoryLabels) as [ProjectCategory, string][];
---

<BaseLayout title="项目" description="徐苏洋的项目归档，涵盖 DTS 前端重构、AI Agent、RAG、Java 全栈、IoT 与自研开发者工具。">
  <header class="archive-hero container">
    <p class="kicker">项目集萃</p>
    <h1>项目归档</h1>
    <p class="lede">按问题、决策与证据组织项目。精确指标未完成原始报告核验时，会明确标记边界。</p>
  </header>

  <nav class="filter-bar container" aria-label="项目分类">
    <button type="button" data-filter="all" aria-pressed="true">全部 <span>{projects.length}</span></button>
    {categories.map(([key, label]) => (
      <button type="button" data-filter={key} aria-pressed="false">{label} <span>{projects.filter((project) => project.category === key).length}</span></button>
    ))}
  </nav>

  <section class="container archive-list" aria-live="polite">
    <div class="archive-grid">
      {projects.map((project, index) => (
        <div data-category={project.category}>
          <ProjectRow project={project} index={index} />
        </div>
      ))}
    </div>
    <p class="empty-state" hidden>当前分类暂无项目。</p>
  </section>

  <section class="section container archive-note">
    <div class="reveal">
      <p class="kicker">展示之则</p>
      <h2>证据优先于包装。</h2>
    </div>
    <div class="reveal">
      <p>企业项目只公开可授权的名称、职责、技术路径与脱敏成果，不展示客户数据、内部地址和源代码。</p>
      <p>公开仓库会标出链接。仍在补证据的性能数字不会被包装成正式结论。</p>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
  const empty = document.querySelector<HTMLElement>('.empty-state');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      let visible = 0;
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      rows.forEach((row) => {
        const show = filter === 'all' || row.dataset.category === filter;
        row.hidden = !show;
        if (show) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
    });
  });
</script>

<style>
  .archive-hero {
    display: grid;
    min-height: 50dvh;
    align-content: end;
    padding-block: clamp(4rem, 10vw, 8rem) 3rem;
  }

  .archive-hero h1 {
    margin-bottom: 1.2rem;
  }

  .archive-hero .lede {
    max-width: 42rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    border-block: 1px solid var(--line);
    padding: 1rem 0;
  }

  .filter-bar button {
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-soft);
    padding: 0.5rem 0.9rem;
    font: 800 0.78rem var(--mono);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }

  .filter-bar button:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .filter-bar button[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .filter-bar span {
    margin-left: 0.4rem;
    font-weight: 800;
  }

  .archive-list {
    padding-block: 3rem;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  [hidden] {
    display: none !important;
  }

  .empty-state {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 2rem;
    color: var(--ink-soft);
    font-weight: 600;
  }

  .archive-note {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 3rem;
    border-top: 1px solid var(--line);
  }

  .archive-note h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .archive-note div:last-child {
    color: var(--ink-soft);
    font-weight: 500;
  }

  .archive-note p {
    margin-bottom: 1rem;
  }

  @media (max-width: 800px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .archive-hero {
      min-height: auto;
    }

    .archive-note {
      grid-template-columns: 1fr;
    }
  }
</style>
