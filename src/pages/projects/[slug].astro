---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import { projects, type Project } from '../../data/projects';
import { evidenceBySlug } from '../../data/evidence';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
const showcase = evidenceBySlug[project.slug];

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': new URL(`/projects/${project.slug}/`, Astro.site).href,
  name: project.title,
  alternateName: project.shortTitle,
  description: project.summary,
  abstract: project.statement,
  url: new URL(`/projects/${project.slug}/`, Astro.site).href,
  image: new URL(project.image, Astro.site).href,
  inLanguage: 'zh-CN',
  genre: project.categoryLabel,
  keywords: project.stack.join(', '),
  creator: { '@id': 'https://xusuyang030218.github.io/#person' },
  author: { '@id': 'https://xusuyang030218.github.io/#person' },
  ...(project.repository ? { codeRepository: project.repository } : {})
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: '项目', item: new URL('/projects/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: project.title }
  ]
};
---

<BaseLayout
  title={project.title}
  description={project.summary}
  image={project.image}
  schema={[projectSchema, breadcrumbSchema]}
>
  <article>
    <header class="case-hero">
      <div class="container case-grid">
        <div class="case-title">
          <a class="back mono" href="/projects/">返回项目归档</a>
          <p class="kicker">{project.categoryLabel}</p>
          <h1>{project.title}</h1>
          <p class="case-summary">{project.summary}</p>
          <div class="case-actions">
            {project.repository && <a class="button" href={project.repository} rel="noopener">查看仓库</a>}
            <a class={`button ${project.repository ? 'secondary' : ''}`} href="mailto:2307456010@qq.com">讨论项目</a>
          </div>
        </div>
        <aside class="case-facts">
          <dl>
            <div><dt>时间</dt><dd>{project.period}</dd></div>
            <div><dt>角色</dt><dd>{project.role}</dd></div>
            <div><dt>亮点</dt><dd>{project.evidence[0]}</dd></div>
          </dl>
          <div class="tags">
            {project.stack.map((item) => <span class="tag">{item}</span>)}
          </div>
        </aside>
      </div>
    </header>

    <blockquote class="case-statement container reveal">
      <p>{project.statement}</p>
    </blockquote>

    <section class="container fact-strip reveal" aria-label="项目关键信息">
      {project.evidence.map((item) => (
        <div><span>{item}</span></div>
      ))}
    </section>

    <div class="case-body container">
      {project.sections.map((section, index) => (
        <section class="case-section reveal">
          <div class="section-label">
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <h2>{section.title}</h2>
          </div>
          <div class="section-content">
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.items && (
              <ol class="decision-list">
                {section.items.map((item, itemIndex) => (
                  <li><b class="mono">{String(itemIndex + 1).padStart(2, '0')}</b><span>{item}</span></li>
                ))}
              </ol>
            )}
          </div>
        </section>
      ))}
    </div>

    {project.architecture && (
      <section class="container architecture reveal" aria-label="系统架构">
        <h2>系统架构</h2>
        <figure>
          <img src={project.architecture.src} alt={project.architecture.alt} loading="lazy" decoding="async" />
          <figcaption>{project.architecture.caption}</figcaption>
        </figure>
      </section>
    )}

    {showcase && <ProjectShowcase evidence={showcase} projectTitle={project.title} />}

    <section class="container highlights reveal">
      <h2>核心亮点</h2>
      <div>
        {project.highlights.map((item) => <p>{item}</p>)}
      </div>
    </section>

    <nav class="next-project" aria-label="下一个项目">
      <a class="container" href={`/projects/${nextProject.slug}/`}>
        <span class="mono">下一篇</span>
        <strong>{nextProject.title}</strong>
        <b aria-hidden="true">↗</b>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .case-hero {
    border-bottom: 1px solid var(--line);
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.65fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .back {
    display: inline-block;
    margin-bottom: 3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.7rem;
    color: var(--ink-soft);
    font-size: 0.74rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .back:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .case-title h1 {
    max-width: 13ch;
    margin-bottom: 1.5rem;
    font-size: clamp(2.6rem, 6vw, 6rem);
  }

  .case-summary {
    max-width: 36rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 500;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .case-facts {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.4rem;
  }

  .case-facts dl {
    margin: 0 0 1.4rem;
  }

  .case-facts dl div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding: 0.8rem 0;
  }

  .case-facts dt {
    color: var(--ink-faint);
    font: 700 0.7rem var(--mono);
  }

  .case-facts dd {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .case-statement {
    padding-block: var(--section);
  }

  .case-statement p {
    max-width: 24ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 5vw, 4.4rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  .case-statement p::before {
    content: "“";
    color: var(--accent);
  }

  .case-statement p::after {
    content: "”";
    color: var(--accent);
  }

  .fact-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    border-block: 1px solid var(--line);
    padding-block: 1rem;
  }

  .fact-strip div {
    display: grid;
    min-height: 6rem;
    align-content: center;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1rem;
  }

  .fact-strip span {
    font-weight: 600;
  }

  .architecture {
    border-top: 1px solid var(--line);
    padding-block: var(--section);
  }

  .architecture h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .architecture figure {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .architecture img {
    display: block;
    width: 100%;
    height: auto;
  }

  .architecture figcaption {
    border-top: 1px solid var(--line);
    padding: 0.9rem 1.2rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .case-body {
    padding-block: var(--section);
  }

  .case-section {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 7vw, 7rem);
    border-top: 1px solid var(--line);
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .section-label {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.7rem;
    align-items: start;
  }

  .section-label > span {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .section-label h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3.5vw, 3rem);
  }

  .section-content {
    color: var(--ink-soft);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .decision-list {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .decision-list li {
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    gap: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1rem;
  }

  .decision-list b {
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .decision-list span {
    color: var(--ink);
    font-weight: 500;
  }

  .highlights {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 3rem;
    border-top: 1px solid var(--line);
    padding-block: var(--section);
  }

  .highlights h2 {
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .highlights div {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .highlights p {
    margin: 0;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    padding: 1rem;
    font-weight: 700;
  }

  .next-project {
    border-top: 1px solid var(--line);
    background: var(--bg-raise);
  }

  .next-project a {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    gap: 2rem;
    align-items: center;
    min-height: 13rem;
    text-decoration: none;
  }

  .next-project span {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .next-project strong {
    font-size: clamp(1.6rem, 4vw, 3.4rem);
    line-height: 1.08;
    font-weight: 800;
  }

  .next-project b {
    color: var(--accent);
    font-size: 2rem;
  }

  @media (max-width: 760px) {
    .case-grid,
    .case-section,
    .highlights {
      grid-template-columns: 1fr;
    }

    .fact-strip,
    .highlights div {
      grid-template-columns: 1fr;
    }

    .fact-strip div {
      min-height: 4.5rem;
    }

    .next-project a {
      grid-template-columns: 1fr auto;
      gap: 1rem;
      padding-block: 2rem;
    }

    .next-project span {
      grid-column: 1 / -1;
    }
  }
</style>
