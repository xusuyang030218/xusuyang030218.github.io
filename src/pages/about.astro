---
import BaseLayout from '../layouts/BaseLayout.astro';

const certificates = [
  { src: '/honors/mcm-honorable-mention.webp', alt: '美国大学生数学建模竞赛 Honorable Mention', label: '美国大学生数学建模竞赛', level: 'Honorable Mention', year: '2025', tier: 'international' },
  { src: '/honors/lanqiao-cpp.webp', alt: '蓝桥杯 C/C++ 程序设计', label: '蓝桥杯全国软件和信息技术专业人才大赛', level: 'C/C++ 程序设计', year: '2024 / 2025', tier: 'national' },
  { src: '/honors/chuanzhi-programming-1st.webp', alt: '传智杯 程序设计 初赛一等奖', label: '传智杯 程序设计挑战赛', level: '初赛一等奖', year: '2025', tier: 'national' },
  { src: '/honors/chuanzhi-programming-provincial-2nd.webp', alt: '传智杯 程序设计 省赛二等奖', label: '传智杯 程序设计挑战赛', level: '省赛二等奖', year: '2025', tier: 'provincial' },
  { src: '/honors/chuanzhi-web-2nd.webp', alt: '传智杯 Web开发 初赛二等奖', label: '传智杯 网页开发挑战赛', level: '初赛二等奖', year: '2025', tier: 'national' },
  { src: '/honors/chuanzhi-web-provincial-3rd.webp', alt: '传智杯 Web开发 省赛三等奖', label: '传智杯 网页开发挑战赛', level: '省赛三等奖', year: '2025', tier: 'provincial' },
  { src: '/honors/infosec-tianti.webp', alt: '全国大学生信息安全竞赛 天梯赛', label: '全国大学生信息安全竞赛', level: '天梯赛', year: '2024', tier: 'national' },
  { src: '/honors/chuanzhi-programming-7th.webp', alt: '第七届传智杯 程序设计挑战赛', label: '第七届传智杯 程序设计', level: '国赛二等奖', year: '2025', tier: 'national' },
  { src: '/honors/chuanzhi-web-7th.webp', alt: '第七届传智杯 网页开发挑战赛', label: '第七届传智杯 网页开发', level: '国赛二等奖', year: '2025', tier: 'national' },
];
---

<BaseLayout title="关于" description="徐苏洋 — 软件工程学生，专注 LLM 应用、Java 全栈与前端重构。">
  <section class="signature container">
    <div class="sig-card reveal">
      <div class="sig-stamp mono">XSY</div>
      <h1>徐苏洋</h1>
      <p class="sig-tag">软件工程 · 2027 届</p>
      <p class="sig-line">把复杂系统做扎实。</p>
      <div class="sig-links">
        <a href="mailto:2307456010@qq.com">邮箱</a>
        <a href="https://github.com/xusuyang030218" rel="me">GitHub</a>
        <a href="https://gitee.com/anhuiwuhu_xsy" rel="me">Gitee</a>
      </div>
    </div>
    <div class="sig-stats reveal">
      <div><strong>35</strong><span>竞赛获奖项次</span></div>
      <div><strong>8</strong><span>完整项目案例</span></div>
      <div><strong>1/33</strong><span>班级排名</span></div>
      <div><strong>1</strong><span>国际级奖项</span></div>
    </div>
  </section>

  <section class="section container story">
    <div class="story-label reveal">
      <p class="kicker">关于我</p>
    </div>
    <div class="story-body reveal">
      <p>就读于大连东软信息学院软件工程专业，班级排名 1/33。</p>
      <p>关注大模型应用如何进入真实系统——权限、审计、流式输出、失败降级、数据边界。也关心遗留代码、团队协作、测试和部署这些不够耀眼却决定交付质量的部分。</p>
      <p>在亚信科技担任前端开发实习生期间，参与 DTS Dashboard 版本升级开发与前端重构，以及数据资产计量计费平台的 React 开发。</p>
    </div>
  </section>

  <section class="section skills-band">
    <div class="container">
      <p class="kicker reveal">能力</p>
      <div class="skill-bars reveal">
        <div class="skill-bar">
          <div class="skill-bar-head"><span>大模型应用</span><b class="mono">85</b></div>
          <div class="skill-bar-track"><div class="skill-bar-fill" data-skill="85"></div></div>
          <p>RAG · LangChain · 向量检索 · Prompt 工程 · SSE · Agent</p>
        </div>
        <div class="skill-bar">
          <div class="skill-bar-head"><span>前端与重构</span><b class="mono">80</b></div>
          <div class="skill-bar-track"><div class="skill-bar-fill" data-skill="80"></div></div>
          <p>Vue 2/3 · React · Element UI · ECharts · 渐进式重构</p>
        </div>
        <div class="skill-bar">
          <div class="skill-bar-head"><span>后端工程</span><b class="mono">75</b></div>
          <div class="skill-bar-track"><div class="skill-bar-fill" data-skill="75"></div></div>
          <p>Spring Boot · MyBatis Plus · MySQL · Redis · Kafka · Docker</p>
        </div>
        <div class="skill-bar">
          <div class="skill-bar-head"><span>Agent Skills</span><b class="mono">70</b></div>
          <div class="skill-bar-track"><div class="skill-bar-fill" data-skill="70"></div></div>
          <p>重构 · 代码检视 · 文档摄取 · 测试 · 可复用执行协议</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section honors-wall">
    <div class="container">
      <div class="honors-head reveal">
        <p class="kicker">荣誉</p>
        <h2>竞赛证书</h2>
        <p class="lede">国际级 1 项、国家级 13 项、省级 21 项。以下为部分证书原件。</p>
      </div>
      <div class="cert-grid reveal" data-stagger>
        {certificates.map((cert) => (
          <figure class="cert-card">
            <img src={cert.src} alt={cert.alt} loading="lazy" decoding="async" />
            <figcaption>
              <span class="cert-level">{cert.level}</span>
              <span class="cert-name">{cert.label}</span>
              <span class="cert-year mono">{cert.year}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Signature card — the "名片" */
  .signature {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: stretch;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .sig-card {
    display: grid;
    align-content: center;
    gap: 0.8rem;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    padding: clamp(2.5rem, 5vw, 4rem);
    box-shadow: var(--shadow-lg);
  }

  .sig-stamp {
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 1rem;
    font-weight: 800;
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.2rem;
  }

  .sig-card h1 {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5.5rem);
    line-height: 1;
  }

  .sig-tag {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .sig-line {
    margin-top: 0.8rem;
    color: var(--accent);
    font-size: clamp(1.3rem, 2.5vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .sig-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .sig-links a {
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--highlight);
    color: var(--ink);
    padding: 0.5rem 1rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  .sig-links a:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow);
  }

  .sig-stats {
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    gap: 1rem;
  }

  .sig-stats div {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    padding: 0.5rem 1.2rem;
    box-shadow: var(--shadow-sm);
  }

  .sig-stats strong {
    color: var(--accent);
    font: 800 clamp(1.5rem, 3vw, 2.4rem) var(--mono);
    line-height: 1;
  }

  .sig-stats span {
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* Story */
  .story {
    display: grid;
    grid-template-columns: minmax(12rem, 0.4fr) minmax(0, 0.6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .story-body {
    color: var(--ink-soft);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.85;
  }

  .story-body p {
    margin-bottom: 1.5rem;
  }

  .story-body p:last-child {
    margin-bottom: 0;
  }

  /* Skills — progress bars */
  .skills-band {
    border-block: 2px solid var(--line);
    background: var(--bg-raise);
  }

  .skill-bars {
    display: grid;
    gap: 1.8rem;
    margin-top: 2.5rem;
  }

  .skill-bar {
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    padding: 1.3rem 1.4rem;
    box-shadow: var(--shadow-sm);
  }

  .skill-bar-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.8rem;
  }

  .skill-bar-head span {
    font-size: 1.1rem;
    font-weight: 800;
    font-family: var(--display);
  }

  .skill-bar-head b {
    color: var(--accent);
    font-size: 1rem;
    font-weight: 800;
  }

  .skill-bar-head b::after {
    content: '%';
    font-size: 0.7rem;
    margin-left: 0.1rem;
  }

  .skill-bar-track {
    width: 100%;
    height: 12px;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--bg-raise);
    overflow: hidden;
  }

  .skill-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--accent);
    transition: none;
  }

  .skill-bar p {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 0.82rem;
    font-weight: 500;
  }

  /* Honors wall — certificate gallery */
  .honors-wall {
    padding-block: var(--section);
  }

  .honors-head {
    margin-bottom: 3rem;
  }

  .honors-head h2 {
    margin-bottom: 0.8rem;
  }

  .honors-head .lede {
    color: var(--ink-soft);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .cert-card {
    margin: 0;
    border: 2px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .cert-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow);
  }

  .cert-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 210 / 297;
    object-fit: cover;
    background: var(--surface-2);
    border-bottom: 2px solid var(--line);
  }

  .cert-card figcaption {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.1rem 1.2rem;
  }

  .cert-level {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .cert-name {
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .cert-year {
    color: var(--ink-faint);
    font-size: 0.72rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .signature {
      grid-template-columns: 1fr;
    }

    .sig-stats {
      grid-template-rows: auto;
      grid-template-columns: repeat(2, 1fr);
    }

    .story {
      grid-template-columns: 1fr;
    }

    .cert-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .cert-grid {
      grid-template-columns: 1fr;
    }

    .sig-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
